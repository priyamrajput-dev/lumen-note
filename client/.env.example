# Lumen Note Client Environment Configuration

# Local Development (using Vite dev server proxy):
# VITE_API_URL=/api

# Production Deployment (e.g. Vercel, Netlify):
# Option 1: Point to your backend server origin
VITE_SERVER_URL=https://lumennote.onrender.com

# Option 2: Or specify the full API URL endpoint
# VITE_API_URL=https://lumennote.onrender.com/api
