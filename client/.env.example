# Lumen Note Client Environment Configuration

# Local Development (using Vite dev server proxy):
# Leave VITE_SERVER_URL empty or unset - the proxy handles /api routes
# VITE_SERVER_URL=

# Production Deployment:
# Set this to your backend server URL (without trailing slash)
# REQUIRED for OAuth in production - frontend must point to backend
# Example: VITE_SERVER_URL=https://lumennote.onrender.com
VITE_SERVER_URL=
