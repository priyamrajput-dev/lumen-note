# Lumen Note Client Environment Configuration

# Local Development (using Vite dev server proxy):
# VITE_API_URL=/api

# Production Deployment (e.g. Vercel, Netlify, Cloudflare Pages):
# Set this to your deployed backend API URL (ending with /api):
# Example: VITE_API_URL=https://your-backend-api.onrender.com/api
# Example: VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=/api
